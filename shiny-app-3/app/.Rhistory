paste0("This dashboard displays data from our real-time monitoring sensors.
For more information on how to navigate the dashboard, please see our <u>", tags$a("dashboard user guide.",
href = "https://canva.link/yne2ktj8dnz2c81",
target = '_blank'), "</u>")
station_name = 'Tenean_Beach'
rm(list = ls())
######################################
#
#   Hohonu Historic Data Download
#
######################################
#load libraries
library(tidyverse)
library(httr2)
library(jsonlite)
library(vroom)
station_name = 'Tenean_Beach'
start_date = as.POSIXct("2024-01-01 00:01:00", tz = "UTC")
end_date = as.POSIXct('2024-12-31 11:59:00', tz = "UTC")
#break the time into 2 week intervals for download
intervals <- seq(from = start_date, to = end_date, by = "2 weeks")
intervals[length(intervals)+1] = end_date
#Device IDs
device_id = read.csv("/Users/katherinezarada/Documents/02_Projects/Climate_Change_Observatory/01_Analysis/Monitoring_Data_Download/00_Data/Inputs/CCO_Sensor_ID.csv") %>%
filter(API == "Hohonu") %>%
filter(Active == "Yes") %>%
filter(Location == station_name)
data_list = list()
for(i in 1:(length(intervals)-1)){
#Create API url
url <- paste0("https://dashboard.hohonu.io/api/v1/stations/hohonu-", device_id$ID, "/waterlevel")
queryString <- list(
from = as.character(intervals[i]),
to = as.character(intervals[i+1]),
units = "english",
datum = "FLOOD_DEPTH",
qc_level = "2",
flags = "true",
predictions = "false",
observations = "true")
req <- request(url) %>%
req_url_query(!!!queryString) %>%
req_headers('Authorization' = '8ff9ceeeef72f06cef5e391662a7c6bf5cc06821',
"Content-Type" = "application/octet-stream",
"Accept" = "application/json")
response <- req_perform(req)
hohonu_download = response %>%
resp_body_json(simplifyVector = TRUE)
hohonu_data = as.data.frame(hohonu_download$data) %>%
mutate(Location = rep(device_id$Location),
Unit = rep(paste(hohonu_download$meta$datum$label,hohonu_download$meta$datum$unit, sep = "_" ))) %>%
rename(Timestamp_UTC = waterlevel.t,
Flood_Depth_FT = waterlevel.o,
QC_Flag = waterlevel.f) %>%
mutate(Time_UTC = str_remove(str_replace(Timestamp_UTC, "T", " "), "Z"),
Time_UTC = as.POSIXct(Time_UTC, tz = "UTC")) %>%
distinct(Time_UTC, .keep_all = T)
data_list[[i]] <- hohonu_data
}
flood.data = do.call(rbind, data_list)
flood.depth = flood.data %>%
distinct(Time_UTC, .keep_all = T)
################### NAVD88 ################
NAVD_data_list = list()
for(i in 1:(length(intervals)-1)){
#Create API url
url <- paste0("https://dashboard.hohonu.io/api/v1/stations/hohonu-", device_id$ID, "/waterlevel")
queryString <- list(
from = as.character(intervals[i]),
to = as.character(intervals[i+1]),
units = "english",
datum = "NAVD",
qc_level = "2",
flags = "true",
predictions = "false",
observations = "true")
req <- request(url) %>%
req_url_query(!!!queryString) %>%
req_headers('Authorization' = '8ff9ceeeef72f06cef5e391662a7c6bf5cc06821',
"Content-Type" = "application/octet-stream",
"Accept" = "application/json")
response <- req_perform(req)
hohonu_download = response %>%
resp_body_json(simplifyVector = TRUE)
NAVD_data = as.data.frame(hohonu_download$data) %>%
mutate(Location = rep(device_id$Location),
Unit = rep(paste(hohonu_download$meta$datum$label,hohonu_download$meta$datum$unit, sep = "_" ))) %>%
rename(Timestamp_UTC = waterlevel.t,
NAVD88_Ft = waterlevel.o,
QC_Flag = waterlevel.f) %>%
mutate(Time_UTC = str_remove(str_replace(Timestamp_UTC, "T", " "), "Z"),
Time_UTC = as.POSIXct(Time_UTC, tz = "UTC")) %>%
distinct(Time_UTC, .keep_all = T)
NAVD_data_list[[i]] <- NAVD_data
}
NAV88_data = do.call(rbind, NAVD_data_list)
NAV88_data = NAV88_data %>% dplyr::select(Time_UTC, NAVD88_Ft)
full_data = left_join(flood.depth, NAV88_data) %>%
dplyr::select(Location, Time_UTC, Flood_Depth_FT, NAVD88_Ft, QC_Flag)
View(full_data)
#
full_data_fix = full_data  %>%
drop_na(NAVD88_Ft) %>%
mutate(Time_UTC_Round = round_date(Time_UTC, unit = "6 minutes"),
Flood_Depth_Updated = NAVD88_Ft - 4.97) %>%
filter(Flood_Depth_Updated >= 0) %>%
filter(Flood_Depth_Updated < 4) %>%
mutate(Diff = Flood_Depth_Updated - lag(Flood_Depth_Updated),
Time_Diff_Min = as.numeric(Time_UTC - lag(Time_UTC))/60,
Rate = abs(Diff/Time_Diff_Min)) %>%
filter(Rate < 0.3)
flat_line = full_data_fix %>%
filter(Rate == 0 & Flood_Depth_Updated> 0)
View(flat_line)
full_data_qc = full_data_fix %>%
dplyr::select(-c(Time_UTC, Flood_Depth_FT)) %>%
rename(Flood_Depth_Ft =Flood_Depth_Updated) %>%
group_by(Time_UTC_Round) %>%
mutate(Flood_Depth_FT = mean(Flood_Depth_Ft, na.rm = T),
NAVD88_Ft = mean(NAVD88_Ft, na.rm = T)) %>%
rename(Time_UTC = Time_UTC_Round) %>%
drop_na(Flood_Depth_Ft) %>%
distinct(Time_UTC, .keep_all = T) %>%
dplyr::select(Location, Time_UTC, Flood_Depth_Ft, NAVD88_Ft, QC_Flag)
write.csv(full_data_qc, "/Users/katherinezarada/Documents/02_Projects/Climate_Change_Observatory/01_Analysis/Repository_Data/01_Hohonu/01_Data/Tenean.Beach_2024.01.01_to_2024.12.31.csv")
rm(list = ls())
